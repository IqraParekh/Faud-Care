# Hostinger panel -> Node.js app -> Environment variables mein ye 3 add karein
# (build se PEHLE set karein, kyunke NEXT_PUBLIC_* build ke time bundle me jaate hain)

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Live domain (sitemap, robots, canonical, OG links yahin se banenge)
NEXT_PUBLIC_SITE_URL=https://fuad.care
